#.env

# ===============================
# 🔐 API KEYS
# ===============================

# Your OpenRouter API Key (get from https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# If you also want to keep OpenAI fallback (optional)
#OPENAI_API_KEY=

# ===============================
# 🌐 APP CONFIG
# ===============================

# Used in API header for ranking your app on OpenRouter
APP_URL=your_app_url_here
APP_NAME=your_app_name_here

# ===============================
# ⚙️ MODEL SETTINGS
# ===============================

# You can use free or premium models
# Examples:
# - openai/gpt-4o-mini
# - openai/gpt-oss-20b:free
# - mistralai/mistral-7b-instruct
# - meta-llama/llama-3.1-8b-instruct
OPENROUTER_MODEL=your_preferred_model_here
